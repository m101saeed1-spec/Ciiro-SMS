rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isPlatformOwner() {
      return isAuthenticated() && (
        request.auth.token.platformOwner == true ||
        exists(/databases/$(database)/documents/platformUsers/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // -------------------------------------------------------------
    // Users Profile Collection
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isUser(userId);
      allow update: if isUser(userId) || isPlatformOwner();
      allow delete: if isPlatformOwner();
    }

    // -------------------------------------------------------------
    // Platform Users Collection
    // -------------------------------------------------------------
    match /platformUsers/{userId} {
      allow read: if isUser(userId) || isPlatformOwner();
      allow write: if isUser(userId) || isPlatformOwner();
    }

    // -------------------------------------------------------------
    // Schools Collection
    // -------------------------------------------------------------
    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isPlatformOwner() || isAuthenticated();
    }

    // -------------------------------------------------------------
    // School Memberships Collection
    // -------------------------------------------------------------
    match /schoolMemberships/{membershipId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isPlatformOwner();
    }

    // -------------------------------------------------------------
    // Students Collection (School-Isolated)
    // -------------------------------------------------------------
    match /students/{studentId} {
      allow read: if isAuthenticated() && (isPlatformOwner() || resource.data.schoolId != null);
      allow create: if isAuthenticated() && (isPlatformOwner() || request.resource.data.schoolId != null);
      allow update: if isAuthenticated() && (isPlatformOwner() || (resource.data.schoolId != null && request.resource.data.schoolId == resource.data.schoolId));
      allow delete: if isAuthenticated() && (isPlatformOwner() || resource.data.schoolId != null);
    }

    // -------------------------------------------------------------
    // Teachers Collection (School-Isolated)
    // -------------------------------------------------------------
    match /teachers/{teacherId} {
      allow read: if isAuthenticated() && (isPlatformOwner() || resource.data.schoolId != null);
      allow create: if isAuthenticated() && (isPlatformOwner() || request.resource.data.schoolId != null);
      allow update: if isAuthenticated() && (isPlatformOwner() || (resource.data.schoolId != null && request.resource.data.schoolId == resource.data.schoolId));
      allow delete: if isAuthenticated() && (isPlatformOwner() || resource.data.schoolId != null);
    }

    // -------------------------------------------------------------
    // Classes & Subjects Collections (School-Isolated)
    // -------------------------------------------------------------
    match /classes/{classId} {
      allow read: if isAuthenticated() && (isPlatformOwner() || resource.data.schoolId != null);
      allow create: if isAuthenticated() && (isPlatformOwner() || request.resource.data.schoolId != null);
      allow update: if isAuthenticated() && (isPlatformOwner() || (resource.data.schoolId != null && request.resource.data.schoolId == resource.data.schoolId));
      allow delete: if isAuthenticated() && (isPlatformOwner() || resource.data.schoolId != null);
    }

    match /subjects/{subjectId} {
      allow read: if isAuthenticated() && (isPlatformOwner() || resource.data.schoolId != null);
      allow create: if isAuthenticated() && (isPlatformOwner() || request.resource.data.schoolId != null);
      allow update: if isAuthenticated() && (isPlatformOwner() || (resource.data.schoolId != null && request.resource.data.schoolId == resource.data.schoolId));
      allow delete: if isAuthenticated() && (isPlatformOwner() || resource.data.schoolId != null);
    }

    // -------------------------------------------------------------
    // Attendance Collection (School-Isolated)
    // -------------------------------------------------------------
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && (isPlatformOwner() || resource.data.schoolId != null);
      allow create: if isAuthenticated() && (isPlatformOwner() || request.resource.data.schoolId != null);
      allow update: if isAuthenticated() && (isPlatformOwner() || (resource.data.schoolId != null && request.resource.data.schoolId == resource.data.schoolId));
      allow delete: if isAuthenticated() && (isPlatformOwner() || resource.data.schoolId != null);
    }

    // -------------------------------------------------------------
    // Academic Results Collection (School-Isolated)
    // -------------------------------------------------------------
    match /academicResults/{resultId} {
      allow read: if isAuthenticated() && (isPlatformOwner() || resource.data.schoolId != null);
      allow create: if isAuthenticated() && (isPlatformOwner() || request.resource.data.schoolId != null);
      allow update: if isAuthenticated() && (isPlatformOwner() || (resource.data.schoolId != null && request.resource.data.schoolId == resource.data.schoolId));
      allow delete: if isAuthenticated() && (isPlatformOwner() || resource.data.schoolId != null);
    }

    // -------------------------------------------------------------
    // Timetables Collection (School-Isolated)
    // -------------------------------------------------------------
    match /timetables/{timetableId} {
      allow read: if isAuthenticated() && (isPlatformOwner() || resource.data.schoolId != null);
      allow create: if isAuthenticated() && (isPlatformOwner() || request.resource.data.schoolId != null);
      allow update: if isAuthenticated() && (isPlatformOwner() || (resource.data.schoolId != null && request.resource.data.schoolId == resource.data.schoolId));
      allow delete: if isAuthenticated() && (isPlatformOwner() || resource.data.schoolId != null);
    }

    // -------------------------------------------------------------
    // Announcements Collection (School-Isolated)
    // -------------------------------------------------------------
    match /announcements/{announcementId} {
      allow read: if isAuthenticated() && (isPlatformOwner() || resource.data.schoolId != null);
      allow create: if isAuthenticated() && (isPlatformOwner() || request.resource.data.schoolId != null);
      allow update: if isAuthenticated() && (isPlatformOwner() || (resource.data.schoolId != null && request.resource.data.schoolId == resource.data.schoolId));
      allow delete: if isAuthenticated() && (isPlatformOwner() || resource.data.schoolId != null);
    }

    // -------------------------------------------------------------
    // Fees & Fee Payments Collections (School-Isolated)
    // -------------------------------------------------------------
    match /fees/{feeId} {
      allow read: if isAuthenticated() && (isPlatformOwner() || resource.data.schoolId != null);
      allow create: if isAuthenticated() && (isPlatformOwner() || request.resource.data.schoolId != null);
      allow update: if isAuthenticated() && (isPlatformOwner() || (resource.data.schoolId != null && request.resource.data.schoolId == resource.data.schoolId));
      allow delete: if isAuthenticated() && (isPlatformOwner() || resource.data.schoolId != null);
    }

    match /feePayments/{paymentId} {
      allow read: if isAuthenticated() && (isPlatformOwner() || resource.data.schoolId != null);
      allow create: if isAuthenticated() && (isPlatformOwner() || request.resource.data.schoolId != null);
      allow update: if isAuthenticated() && (isPlatformOwner() || (resource.data.schoolId != null && request.resource.data.schoolId == resource.data.schoolId));
      allow delete: if isAuthenticated() && (isPlatformOwner() || resource.data.schoolId != null);
    }

    match /teacherPayments/{paymentId} {
      allow read: if isAuthenticated() && (isPlatformOwner() || resource.data.schoolId != null);
      allow create: if isAuthenticated() && (isPlatformOwner() || request.resource.data.schoolId != null);
      allow update: if isAuthenticated() && (isPlatformOwner() || (resource.data.schoolId != null && request.resource.data.schoolId == resource.data.schoolId));
      allow delete: if isAuthenticated() && (isPlatformOwner() || resource.data.schoolId != null);
    }

    // -------------------------------------------------------------
    // Audit Logs Collection (Append-Only)
    // -------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isPlatformOwner();
    }

    // -------------------------------------------------------------
    // Connectivity Test Path
    // -------------------------------------------------------------
    match /test/{testId} {
      allow read: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
